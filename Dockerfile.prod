FROM node:lts AS build
WORKDIR /app

ARG API_BASE_URL 
ARG APP_DOMAIN 
ARG APP_NAME 
ARG APP_URL 
ARG APP_ENVIRONMENT
ARG COMPATIBILITY_DATE
ARG NUXT_RESEND_API_KEY
ARG SENTRY_DSN
ARG SENTRY_AUTH_TOKEN

ENV npm_config_platform=linux
ENV npm_config_libc=glibc
ENV PNPM_HOME="/root/.local/share/pnpm"
ENV PATH="/root/.local/share/pnpm:$PATH"

RUN apt-get update && apt-get install -y --no-install-recommends \
  python3 \
  build-essential \
  libvips-dev \
  && rm -rf /var/lib/apt/lists/*

RUN npm install --quiet node-gyp -g && \
    npm install -g pnpm@latest

COPY package.json pnpm-lock.yaml pnpm.json pnpm-workspace.yaml ./

RUN  pnpm install && \
  pnpm install vue
# pnpm config set store-dir /root/.local/share/pnpm/store --global && \

COPY . .

ENV PATH="./node_modules/.bin/:$PATH"

RUN pnpm run build

FROM node:lts-slim

WORKDIR /app

# .output est autonome : Nitro y embarque les seules dépendances utilisées à
# l'exécution. Copier node_modules ajoutait les outils de build et de test
# (esbuild, happy-dom…) et leurs CVE à l'image de production.
COPY --from=build /app/.output /app/.output

# npm et corepack (fournis par l'image node) ne servent pas à lancer le site,
# et embarquent leurs propres dépendances vulnérables
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
  /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack

EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]